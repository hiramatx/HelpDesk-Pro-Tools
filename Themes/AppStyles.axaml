<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Windows -->
    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource WindowBgBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!-- Cards -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="18,14" />
        <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}" />
    </Style>

    <Style Selector="TextBlock.cardTitle">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Margin" Value="4,0,0,8" />
    </Style>

    <Style Selector="TextBlock.label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>

    <Style Selector="TextBlock.value">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>

    <!-- Flat buttons -->
    <Style Selector="Button.flat">
        <Setter Property="Background" Value="{DynamicResource FlatButtonBgBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource FlatButtonFgBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.flat:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FlatButtonHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource FlatButtonFgBrush}" />
    </Style>
    <Style Selector="Button.flat:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FlatButtonPressedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource FlatButtonFgBrush}" />
    </Style>
    <Style Selector="Button.flat:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FlatButtonBgBrush}" />
        <Setter Property="Opacity" Value="0.5" />
    </Style>

    <!-- Script button whose .ps1 file can't be found -->
    <Style Selector="Button.flat.missing">
        <Setter Property="Opacity" Value="0.45" />
    </Style>

    <!-- Solid variants (Blue / Cyan / Green / Red / neutral "primary") -->
    <Style Selector="Button.flat.primary">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentFgBrush}" />
    </Style>
    <Style Selector="Button.flat.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentFgBrush}" />
        <Setter Property="Opacity" Value="0.88" />
    </Style>

    <Style Selector="Button.flat.blue">
        <Setter Property="Background" Value="{StaticResource BlueBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.flat.blue:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BlueHoverBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="Button.flat.cyan">
        <Setter Property="Background" Value="{StaticResource CyanBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.flat.cyan:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource CyanHoverBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="Button.flat.green">
        <Setter Property="Background" Value="{StaticResource GreenBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.flat.green:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource GreenHoverBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="Button.flat.red">
        <Setter Property="Background" Value="{StaticResource RedBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.flat.red:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource RedHoverBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="Button.flat.blue:pressed /template/ ContentPresenter#PART_ContentPresenter,
                     Button.flat.cyan:pressed /template/ ContentPresenter#PART_ContentPresenter,
                     Button.flat.green:pressed /template/ ContentPresenter#PART_ContentPresenter,
                     Button.flat.red:pressed /template/ ContentPresenter#PART_ContentPresenter,
                     Button.flat.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Opacity" Value="0.8" />
    </Style>
    <Style Selector="Button.flat.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource AccentFgBrush}" />
    </Style>

    <!-- Flat tabs -->
    <Style Selector="TabControl.flatTabs TabItem">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TabControl.flatTabs TabItem:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource FlatButtonBgBrush}" />
    </Style>
    <Style Selector="TabControl.flatTabs TabItem:selected">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    </Style>

    <!-- Icon paths (sun / moon, etc.) -->
    <Style Selector="Path.icon">
        <Setter Property="Stroke" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Path.icon.active">
        <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
    </Style>
</Styles>
