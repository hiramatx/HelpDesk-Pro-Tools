<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HelpDesk_Pro_Tools.ViewModels"
        xmlns:m="using:HelpDesk_Pro_Tools.Models"
        xmlns:c="using:HelpDesk_Pro_Tools.Controls"
        x:Class="HelpDesk_Pro_Tools.Views.PcDetailsWindow"
        x:DataType="vm:PcDetailsViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding PcName, StringFormat='PC Details - {0}'}"
        Width="880" Height="1000" MinWidth="700" MinHeight="500"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="c|LiquidFillGauge">
            <Setter Property="Width" Value="100" />
            <Setter Property="Height" Value="100" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TrackBrush" Value="{DynamicResource GaugeTrackBrush}" />
            <Setter Property="TextBrush" Value="{DynamicResource TextPrimaryBrush}" />
            <!-- Liquid colour by usage: 0-50% green, 51-85% yellow, 86-100% red -->
            <Setter Property="NormalBrush" Value="{StaticResource GreenBrush}" />
            <Setter Property="WarningBrush" Value="{StaticResource YellowBrush}" />
            <Setter Property="CriticalBrush" Value="{StaticResource RedBrush}" />
            <Setter Property="WarningLiquidTextBrush" Value="{StaticResource DarkTextBrush}" />
        </Style>

        <Style Selector="SelectableTextBlock.fieldValue">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Software versions vs baselines.json: green = up to date, red = outdated / missing, orange = couldn't check -->
        <Style Selector="SelectableTextBlock.fieldValue.ok">
            <Setter Property="Foreground" Value="{StaticResource GreenBrush}" />
        </Style>
        <Style Selector="SelectableTextBlock.fieldValue.bad">
            <Setter Property="Foreground" Value="{StaticResource RedBrush}" />
        </Style>
        <Style Selector="SelectableTextBlock.fieldValue.warn">
            <Setter Property="Foreground" Value="{StaticResource StandardIndicatorBrush}" />
        </Style>
        <Style Selector="SelectableTextBlock.fieldValue.caution">
            <Setter Property="Foreground" Value="{DynamicResource CautionTextBrush}" />
        </Style>
    </Window.Styles>

    <Window.Resources>
        <!-- "Label: value" cell for the 2-column sections. Spacer cells keep their slot but show nothing. -->
        <DataTemplate x:Key="FieldTemplate" x:DataType="m:InfoField">
            <Grid ColumnDefinitions="Auto,*" Margin="4,4" IsVisible="{Binding !IsSpacer}">
                <TextBlock Classes="label" Text="{Binding Label, StringFormat='{}{0}:'}"
                           MinWidth="112" Margin="0,1,8,0" VerticalAlignment="Top" />
                <SelectableTextBlock Grid.Column="1" Classes="fieldValue" Text="{Binding Value}"
                                     Classes.ok="{Binding IsOk}" Classes.bad="{Binding IsBad}" Classes.warn="{Binding IsWarn}"
                                     Classes.caution="{Binding IsCaution}"
                                     ToolTip.Tip="{Binding ToolTip}" />
            </Grid>
        </DataTemplate>

        <!-- Wider label column for the single-column Users and Hardware sections -->
        <DataTemplate x:Key="WideFieldTemplate" x:DataType="m:InfoField">
            <Grid ColumnDefinitions="Auto,*" Margin="4,4">
                <TextBlock Classes="label" Text="{Binding Label, StringFormat='{}{0}:'}"
                           MinWidth="150" Margin="0,1,8,0" VerticalAlignment="Top" />
                <SelectableTextBlock Grid.Column="1" Classes="fieldValue" Text="{Binding Value}"
                                     Classes.ok="{Binding IsOk}" Classes.bad="{Binding IsBad}" Classes.warn="{Binding IsWarn}"
                                     Classes.caution="{Binding IsCaution}"
                                     ToolTip.Tip="{Binding ToolTip}" />
            </Grid>
        </DataTemplate>

        <!-- One row of a 2-column section: left and right cells share the width equally -->
        <DataTemplate x:Key="RowTemplate" x:DataType="m:InfoRow">
            <Grid ColumnDefinitions="*,*">
                <ContentControl Content="{Binding Left}" ContentTemplate="{StaticResource FieldTemplate}" />
                <ContentControl Grid.Column="1" Content="{Binding Right}" ContentTemplate="{StaticResource FieldTemplate}" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid RowDefinitions="Auto,*" Margin="16">

        <!-- Header -->
        <Border Classes="card" Margin="0,0,0,12">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="PC Details" FontSize="22" FontWeight="Bold" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding PcName}" Classes="muted" FontSize="12" />
                        <!-- Hover for how long each section took -->
                        <TextBlock Text="{Binding LoadTime}" Classes="muted" FontSize="12"
                                   IsVisible="{Binding LoadTime, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   ToolTip.Tip="{Binding LoadTimeDetails}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="90" IsVisible="{Binding IsLoading}" />
                    <Button Classes="flat primary" Content="Refresh" Width="100" Command="{Binding RefreshCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12" Margin="0,0,4,8">

                <!-- Connection error -->
                <Border Classes="card" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource RedBrush}" TextWrapping="Wrap" />
                </Border>

                <Border Classes="card" IsVisible="{Binding IsConnecting}">
                    <TextBlock Classes="muted" Text="Collecting details over WMI..." HorizontalAlignment="Center" Margin="0,20" />
                </Border>

                <StackPanel Spacing="12" IsVisible="{Binding HasData}">

                    <!-- Utilization -->
                    <Border Classes="card">
                        <StackPanel>
                            <TextBlock Classes="cardTitle" Text="Utilization" />
                            <TextBlock Classes="muted" Text="Loading..." Margin="4" IsVisible="{Binding !UtilizationLoaded}" />
                            <UniformGrid Columns="3" Margin="0,2" IsVisible="{Binding UtilizationLoaded}">
                                <StackPanel Spacing="6">
                                    <c:LiquidFillGauge Value="{Binding CpuPercent}" />
                                    <TextBlock Text="CPU Usage" HorizontalAlignment="Center" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <c:LiquidFillGauge Value="{Binding RamPercent}" />
                                    <TextBlock Text="RAM Usage" HorizontalAlignment="Center" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding RamText}" HorizontalAlignment="Center" Classes="label" />
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <c:LiquidFillGauge Value="{Binding DiskPercent}" />
                                    <TextBlock Text="Storage Used" HorizontalAlignment="Center" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding DiskText}" HorizontalAlignment="Center" Classes="label" />
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Software -->
                    <Border Classes="card">
                        <StackPanel>
                            <TextBlock Classes="cardTitle" Text="Software" />
                            <TextBlock Classes="muted" Text="Loading..." Margin="4" IsVisible="{Binding !SoftwareLoaded}" />
                            <ItemsControl ItemsSource="{Binding SoftwareRows}"
                                          ItemTemplate="{StaticResource RowTemplate}" />
                        </StackPanel>
                    </Border>

                    <!-- PC -->
                    <Border Classes="card">
                        <StackPanel>
                            <TextBlock Classes="cardTitle" Text="PC" />
                            <TextBlock Classes="muted" Text="Loading..." Margin="4" IsVisible="{Binding !PcLoaded}" />
                            <ItemsControl ItemsSource="{Binding PcRows}"
                                          ItemTemplate="{StaticResource RowTemplate}" />
                        </StackPanel>
                    </Border>

                    <!-- Users -->
                    <Border Classes="card">
                        <StackPanel>
                            <TextBlock Classes="cardTitle" Text="Users" />
                            <TextBlock Classes="muted" Text="Loading..." Margin="4" IsVisible="{Binding !UsersLoaded}" />
                            <ItemsControl ItemsSource="{Binding UserFields}"
                                          ItemTemplate="{StaticResource WideFieldTemplate}" />
                        </StackPanel>
                    </Border>

                    <!-- Hardware -->
                    <Border Classes="card">
                        <StackPanel>
                            <TextBlock Classes="cardTitle" Text="Hardware" />
                            <TextBlock Classes="muted" Text="Loading..." Margin="4" IsVisible="{Binding !HardwareLoaded}" />
                            <ItemsControl ItemsSource="{Binding HardwareFields}"
                                          ItemTemplate="{StaticResource WideFieldTemplate}" />
                        </StackPanel>
                    </Border>

                    <!-- Device Manager -->
                    <Border Classes="card">
                        <StackPanel>
                            <TextBlock Classes="cardTitle" Text="Device Manager Errors" />
                            <TextBlock Classes="muted" Text="Loading..." Margin="4" IsVisible="{Binding !DeviceManagerLoaded}" />
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="4" IsVisible="{Binding NoDeviceErrors}">
                                <Ellipse Width="10" Height="10" Fill="{StaticResource GreenBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="No device errors found" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding DeviceErrors}" IsVisible="{Binding HasDeviceErrors}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="m:DeviceError">
                                        <Grid ColumnDefinitions="Auto,*" Margin="4,3">
                                            <Ellipse Width="10" Height="10" Fill="{StaticResource RedBrush}" VerticalAlignment="Top" Margin="0,5,10,0" />
                                            <StackPanel Grid.Column="1">
                                                <SelectableTextBlock Classes="fieldValue" Text="{Binding Name}" />
                                                <TextBlock Classes="label" Text="{Binding Description}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Partial failures -->
                    <Border Classes="card" IsVisible="{Binding Warnings, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <SelectableTextBlock Text="{Binding Warnings}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
