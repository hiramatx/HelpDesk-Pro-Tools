<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="using:HelpDesk_Pro_Tools.Services"
        xmlns:vm="using:HelpDesk_Pro_Tools.ViewModels"
        x:Class="HelpDesk_Pro_Tools.Views.AddRemoteDesktopWindow"
        x:DataType="vm:AddRemoteDesktopViewModel"
        Icon="{x:Static svc:AppIcon.Current}"
        Title="{Binding PcName, StringFormat='Add Remote Desktop - {0}'}"
        Width="480" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">

    <Border Classes="card" Margin="16">
        <StackPanel Spacing="10">
            <TextBlock FontSize="18" FontWeight="Bold" Text="{Binding PcName, StringFormat='Add Remote Desktop on {0}'}" />

            <TextBox x:Name="UserInput" Text="{Binding UserName}" PlaceholderText="User name (jdoe or DOMAIN\jdoe)" />

            <StackPanel Spacing="2">
                <CheckBox Content="Remote Desktop Users" IsChecked="{Binding AddRemoteDesktopUser}" />
                <CheckBox Content="Direct Access Users" IsChecked="{Binding AddDirectAccessUser}" />
            </StackPanel>

            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12"
                       IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Classes.error="{Binding IsError}">
                <TextBlock.Styles>
                    <Style Selector="TextBlock.error">
                        <Setter Property="Foreground" Value="{StaticResource RedBrush}" />
                    </Style>
                </TextBlock.Styles>
            </TextBlock>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Classes="flat" Content="Close" Width="110" Click="Close_Click" />
                <Button Classes="flat purple" Content="Add" Width="110" IsDefault="True" Command="{Binding AddCommand}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
