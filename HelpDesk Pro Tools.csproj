<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>HelpDesk_Pro_Tools</RootNamespace>
    <AssemblyName>HelpDeskProTools</AssemblyName>
    <!-- 5.x = the C# / Avalonia rewrite (the earlier WPF tools ended at 3.0; 4.x was skipped) -->
    <Version>5.1.6</Version>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Exe icon: Resources\hdpt.ico when present, otherwise the built-in Avalonia icon -->
    <ApplicationIcon Condition="Exists('Resources\hdpt.ico')">Resources\hdpt.ico</ApplicationIcon>
    <ApplicationIcon Condition="!Exists('Resources\hdpt.ico')">Assets\avalonia-logo.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Config files are copied to Config\ next to the exe so they can be edited without rebuilding -->
    <None Update="Config\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Scripts\**\*.ps1" CopyToOutputDirectory="PreserveNewest" />
    <!-- Window / taskbar icon, loaded from Resources\hdpt.ico next to the exe (see Services\AppIcon.cs) -->
    <None Include="Resources\*.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="System.DirectoryServices" Version="10.0.0" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.0" />
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>
</Project>
